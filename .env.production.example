# Produção: copie para .env.production no servidor e preencha. Nunca entra no git.
# Segredos novos: openssl rand -hex 32

# O domínio da app, já a apontar para o servidor (sem https://)
APP_DOMAIN="app.exemplo.pt"

POSTGRES_PASSWORD=""
SESSION_SECRET=""
ENCRYPTION_KEY=""

# O primeiro utilizador (ADMIN). Só é criado se ainda não existir; a senha de um existente não muda.
DEFAULT_ADMIN_NAME="Isabel"
DEFAULT_ADMIN_EMAIL=""
DEFAULT_ADMIN_PASSWORD=""

ANTHROPIC_API_KEY=""
OPENAI_API_KEY=""

# Google: credenciais OAuth com o URI de redirecionamento https://<APP_DOMAIN>/api/google/callback
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# WhatsApp (Evolution API)
EVOLUTION_API_KEY=""
EVOLUTION_INSTANCE="escritorio"
WHATSAPP_WEBHOOK_SECRET=""

# AI Office (opcional)
OFFICE_API_TOKEN=""
