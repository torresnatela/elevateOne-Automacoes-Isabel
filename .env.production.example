# Produção: copie para .env.production no servidor e preencha. Nunca entra no git.
# Segredos novos: openssl rand -hex 32

# O domínio da app, já a apontar para o servidor (sem https://)
APP_DOMAIN="app.exemplo.pt"

POSTGRES_PASSWORD=""
SESSION_SECRET=""
ENCRYPTION_KEY=""

# O primeiro utilizador (ADMIN). Só é criado se ainda não existir; a senha de um existente não muda.
DEFAULT_ADMIN_NAME="Isabel"
DEFAULT_ADMIN_EMAIL=""
DEFAULT_ADMIN_PASSWORD=""

ANTHROPIC_API_KEY=""
# Só para uma chave que não está ligada a um workspace: o id do workspace a usar (wrkspc_…)
ANTHROPIC_WORKSPACE_ID=""
OPENAI_API_KEY=""

# Google: credenciais OAuth com o URI de redirecionamento https://<APP_DOMAIN>/api/google/callback
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Microsoft (OneDrive): URI de redirecionamento https://<APP_DOMAIN>/api/microsoft/callback (docs/onedrive.md)
MICROSOFT_CLIENT_ID=""
MICROSOFT_CLIENT_SECRET=""
MICROSOFT_TENANT_ID="common"

# WhatsApp (Evolution API)
EVOLUTION_API_KEY=""
EVOLUTION_INSTANCE="escritorio"
WHATSAPP_WEBHOOK_SECRET=""

# AI Office (opcional)
OFFICE_API_TOKEN=""

# Agente de faturas (lê os emails dos clientes nas contas Google ligadas)
# O segredo com que o agendamento da Vercel chama /api/jobs/client-mail-sync (pelo menos 16 caracteres).
CRON_SECRET=""
# Opcional: o modelo que lê as faturas (por omissão claude-sonnet-5-5).
INVOICE_EXTRACTOR_MODEL=""
