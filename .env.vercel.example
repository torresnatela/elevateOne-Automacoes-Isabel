# Vercel (Project Settings → Environment Variables → Production). Nunca entra no git.
# Segredos novos: openssl rand -hex 32

# O Postgres da Hostinger: os valores de .env.hostinger, o IP/domínio do servidor, SSL obrigatório
DATABASE_URL="postgresql://USER:SENHA@IP_DO_SERVIDOR:5432/NOME_DO_BANCO?schema=public&sslmode=require&connection_limit=3&connect_timeout=15"

SESSION_SECRET=""
# Cifra os acessos ao Google e à Microsoft guardados no banco. Guarde-a à parte: sem ela, perdem-se.
ENCRYPTION_KEY=""
# O endereço público da app na Vercel, sem barra no fim
APP_URL="https://app.exemplo.com"

ANTHROPIC_API_KEY=""
ANTHROPIC_WORKSPACE_ID=""
ANTHROPIC_MODEL="claude-opus-5-5"
ANTHROPIC_EFFORT="medium"
OPENAI_API_KEY=""

# Google: URI de redirecionamento <APP_URL>/api/google/callback
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Microsoft (OneDrive): URI de redirecionamento <APP_URL>/api/microsoft/callback (docs/onedrive.md)
MICROSOFT_CLIENT_ID=""
MICROSOFT_CLIENT_SECRET=""
MICROSOFT_TENANT_ID="common"

# WhatsApp: a Evolution na Hostinger, pelo HTTPS do Caddy
EVOLUTION_API_URL="https://evolution.exemplo.com"
EVOLUTION_API_KEY=""
EVOLUTION_INSTANCE="escritorio"
WHATSAPP_WEBHOOK_SECRET=""

OFFICE_API_TOKEN=""

# Agente de faturas (lê os emails dos clientes nas contas Google ligadas)
# O segredo com que o agendamento da Vercel chama /api/jobs/client-mail-sync (pelo menos 16 caracteres).
CRON_SECRET=""
# Opcional: o modelo que lê as faturas (por omissão claude-sonnet-5-5).
INVOICE_EXTRACTOR_MODEL=""
