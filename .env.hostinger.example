# Servidor da Hostinger (docker-compose.hostinger.yml): o Postgres e a Evolution API.
# Copie para .env.hostinger no servidor e preencha. Nunca entra no git.
# Segredos novos: openssl rand -hex 32

# O utilizador, a senha e o nome do banco da app (os mesmos da DATABASE_URL na Vercel)
POSTGRES_USER=""
POSTGRES_PASSWORD=""
POSTGRES_DB=""
# A porta pública do Postgres (opcional; por omissão 5432)
POSTGRES_PORT="5432"

# O subdomínio da Evolution, já a apontar para o IP do servidor (sem https://)
EVOLUTION_DOMAIN="evolution.exemplo.com"
EVOLUTION_API_KEY=""
