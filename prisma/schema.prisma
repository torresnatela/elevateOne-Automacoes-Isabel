generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  USER
}

model User {
  id                 String              @id @default(uuid()) @db.Uuid
  name               String
  email              String              @unique
  passwordHash       String              @map("password_hash")
  /// O número de WhatsApp autorizado a falar com os agentes (só dígitos, com o indicativo).
  phone              String?             @unique
  role               Role                @default(USER)
  active             Boolean             @default(true)
  createdAt          DateTime            @default(now()) @map("created_at")
  updatedAt          DateTime            @updatedAt @map("updated_at")
  conversations      Conversation[]
  knowledgeDocuments KnowledgeDocument[]
  googleAccount      GoogleAccount?
  microsoftAccount   MicrosoftAccount?
  clients            Client[]

  @@map("users")
}

enum Channel {
  WEB
  WHATSAPP
}

enum MessageRole {
  USER
  ASSISTANT
}

enum AgentState {
  WORKING
  IDLE
  NEEDS_HELP
}

/// Uma conversa de alguém com um agente, num canal.
model Conversation {
  id             String          @id @default(uuid()) @db.Uuid
  agentId        String          @map("agent_id")
  channel        Channel
  userId         String?         @map("user_id") @db.Uuid
  /// Quem fala, fora do sistema (ex.: o número do WhatsApp).
  externalId     String?         @map("external_id")
  /// O que aparece na lista de conversas (o início da primeira mensagem).
  title          String?
  createdAt      DateTime        @default(now()) @map("created_at")
  updatedAt      DateTime        @updatedAt @map("updated_at")
  user           User?           @relation(fields: [userId], references: [id], onDelete: SetNull)
  messages       Message[]
  pendingActions PendingAction[]

  @@index([agentId, userId])
  @@index([agentId, channel, externalId])
  @@map("conversations")
}

/// Uma mensagem da conversa. `content` guarda os blocos tal como o modelo os devolveu.
model Message {
  id             String       @id @default(uuid()) @db.Uuid
  conversationId String       @map("conversation_id") @db.Uuid
  seq            Int          @default(autoincrement())
  role           MessageRole
  content        Json
  createdAt      DateTime     @default(now()) @map("created_at")
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, seq])
  @@map("messages")
}

/// O que um agente fez, no formato que o AI Office mostra (a `Entrada` de src/mapa/atividade.ts).
model AgentEvent {
  id        String     @id @default(uuid()) @db.Uuid
  seq       Int        @unique @default(autoincrement())
  /// O id do colaborador no AI Office.
  agent     String
  state     AgentState
  type      String?
  text      String
  tool      String?
  /// Os minutos que uma pessoa levaria (0 nos alertas e nos estados).
  minutes   Int        @default(0)
  createdAt DateTime   @default(now()) @map("created_at")

  @@map("agent_events")
}

/// Um ficheiro da base de conhecimento (o que a equipa pode perguntar ao chat).
model KnowledgeDocument {
  id           String           @id @default(uuid()) @db.Uuid
  title        String
  fileName     String           @map("file_name")
  mimeType     String           @map("mime_type")
  size         Int
  chunkCount   Int              @map("chunk_count")
  uploadedById String?          @map("uploaded_by_id") @db.Uuid
  createdAt    DateTime         @default(now()) @map("created_at")
  uploadedBy   User?            @relation(fields: [uploadedById], references: [id], onDelete: SetNull)
  chunks       KnowledgeChunk[]

  @@map("knowledge_documents")
}

/// Um pedaço de um ficheiro, com o seu vetor (pgvector) para a procura por sentido.
model KnowledgeChunk {
  id         String                      @id @default(uuid()) @db.Uuid
  documentId String                      @map("document_id") @db.Uuid
  position   Int
  content    String
  embedding  Unsupported("vector(1536)")
  document   KnowledgeDocument           @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([documentId, position])
  @@map("knowledge_chunks")
}

/// O que o admin mudou num agente sem deploy (hoje, as instruções).
model AgentSetting {
  agentId   String   @id @map("agent_id")
  prompt    String
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("agent_settings")
}

/// A conta Google que um utilizador ligou (os agentes agem nela em nome dele).
model GoogleAccount {
  id                    String            @id @default(uuid()) @db.Uuid
  userId                String            @unique @map("user_id") @db.Uuid
  email                 String
  /// O refresh token, cifrado (AES-256-GCM, chave em ENCRYPTION_KEY).
  refreshTokenEncrypted String            @map("refresh_token_encrypted")
  /// As permissões que a pessoa deu, separadas por espaços.
  scopes                String
  createdAt             DateTime          @default(now()) @map("created_at")
  updatedAt             DateTime          @updatedAt @map("updated_at")
  user                  User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  clientEmails          ClientEmail[]
  mailSyncState         MailSyncState?
  seenMessages          MailSeenMessage[]

  @@map("google_accounts")
}

/// A conta Microsoft (OneDrive) que um utilizador ligou, e a pasta da empresa que escolheu.
model MicrosoftAccount {
  id                    String   @id @default(uuid()) @db.Uuid
  userId                String   @unique @map("user_id") @db.Uuid
  email                 String
  /// O refresh token, cifrado (AES-256-GCM, chave em ENCRYPTION_KEY). A Microsoft troca-o a cada renovação.
  refreshTokenEncrypted String   @map("refresh_token_encrypted")
  /// As permissões que a pessoa deu, separadas por espaços.
  scopes                String
  /// A pasta onde a empresa guarda os documentos (o drive e o item no Microsoft Graph).
  folderDriveId         String?  @map("folder_drive_id")
  folderItemId          String?  @map("folder_item_id")
  folderName            String?  @map("folder_name")
  folderWebUrl          String?  @map("folder_web_url")
  createdAt             DateTime @default(now()) @map("created_at")
  updatedAt             DateTime @updatedAt @map("updated_at")
  user                  User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("microsoft_accounts")
}

enum PendingActionStatus {
  PENDING
  CONFIRMED
  CANCELLED
  EXPIRED
  FAILED
}

/// Uma ação que escreve no mundo (marcar, enviar, apagar), à espera do «sim» de quem pediu.
model PendingAction {
  id             String              @id @default(uuid()) @db.Uuid
  conversationId String              @map("conversation_id") @db.Uuid
  /// A vez (mensagem) em que foi proposta: só pode ser confirmada numa vez seguinte.
  runId          String              @map("run_id")
  toolName       String              @map("tool_name")
  input          Json
  /// O que foi mostrado a quem pediu.
  description    String
  status         PendingActionStatus @default(PENDING)
  expiresAt      DateTime            @map("expires_at")
  createdAt      DateTime            @default(now()) @map("created_at")
  resolvedAt     DateTime?           @map("resolved_at")
  conversation   Conversation        @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, status])
  @@map("pending_actions")
}

/// As mensagens do WhatsApp já recebidas, para não tratar a mesma duas vezes.
model InboundMessage {
  id         String   @id
  receivedAt DateTime @default(now()) @map("received_at")

  @@map("inbound_messages")
}

enum ClientEntityType {
  SOCIEDADE
  ENI
  PARTICULAR
  ASSOCIACAO
  OUTRO
}

enum VatRegime {
  NORMAL_MENSAL
  NORMAL_TRIMESTRAL
  ISENTO_ART53
  PEQUENOS_RETALHISTAS
  NAO_SUJEITO
}

enum AccountingRegime {
  ORGANIZADA
  SIMPLIFICADO
  NAO_ORGANIZADA
}

/**
 * Um cliente do gabinete: quem é, como se reconhece pelo email e os dados contabilísticos (PT).
 */
model Client {
  id                String            @id @default(uuid()) @db.Uuid
  /// A denominação (ou o nome, num particular).
  name              String
  tradeName         String?           @map("trade_name")
  /// O NIF/NIPC, 9 dígitos.
  nif               String?           @unique
  /// Os endereços de email do cliente, em minúsculas: é por eles que o agente reconhece os emails.
  contactEmails     String[]          @map("contact_emails")
  /// Domínios inteiros do cliente (ex.: «empresa.pt»): qualquer remetente desse domínio conta.
  emailDomains      String[]          @map("email_domains")
  entityType        ClientEntityType  @default(SOCIEDADE) @map("entity_type")
  vatRegime         VatRegime?        @map("vat_regime")
  accountingRegime  AccountingRegime? @map("accounting_regime")
  /// O CAE principal (5 dígitos).
  caePrincipal      String?           @map("cae_principal")
  /// O número de identificação da Segurança Social (11 dígitos).
  niss              String?
  address           String?
  postalCode        String?           @map("postal_code")
  city              String?
  country           String            @default("PT")
  /// O contabilista responsável.
  responsibleUserId String?           @map("responsible_user_id") @db.Uuid
  notes             String?
  active            Boolean           @default(true)
  createdAt         DateTime          @default(now()) @map("created_at")
  updatedAt         DateTime          @updatedAt @map("updated_at")
  responsibleUser   User?             @relation(fields: [responsibleUserId], references: [id], onDelete: SetNull)
  mailMessages      ClientEmail[]
  invoices          Invoice[]

  @@index([contactEmails], type: Gin)
  @@index([emailDomains], type: Gin)
  @@map("clients")
}

/**
 * Um email que um cliente mandou, lido pelo agente de faturas, com o resumo que ele fez.
 */
model ClientEmail {
  id              String         @id @default(uuid()) @db.Uuid
  clientId        String         @map("client_id") @db.Uuid
  /// A caixa onde foi lido (a conta Google ligada); fica a null se a conta for desligada.
  googleAccountId String?        @map("google_account_id") @db.Uuid
  /// O endereço dessa caixa, para se saber onde procurar mesmo depois de a desligarem.
  mailbox         String
  gmailMessageId  String         @map("gmail_message_id")
  gmailThreadId   String?        @map("gmail_thread_id")
  /// O cabeçalho Message-ID: o mesmo email recebido em várias caixas guarda-se uma vez.
  rfcMessageId    String         @unique @map("rfc_message_id")
  fromAddress     String         @map("from_address")
  subject         String
  receivedAt      DateTime       @map("received_at")
  summary         String
  category        String
  actionNeeded    Boolean        @default(false) @map("action_needed")
  attachmentCount Int            @default(0) @map("attachment_count")
  createdAt       DateTime       @default(now()) @map("created_at")
  client          Client         @relation(fields: [clientId], references: [id], onDelete: Cascade)
  googleAccount   GoogleAccount? @relation(fields: [googleAccountId], references: [id], onDelete: SetNull)
  invoices        Invoice[]

  @@unique([googleAccountId, gmailMessageId])
  @@index([clientId, receivedAt])
  @@map("client_emails")
}

enum InvoiceDocType {
  FT
  FS
  FR
  NC
  ND
  RC
  OUTRO
}

enum InvoiceStatus {
  /// Extraída e coerente (NIF válido, totais batem certo).
  EXTRAIDA
  /// Algo não bate certo ou o modelo teve dúvidas: alguém tem de ver.
  A_REVER
  CONFIRMADA
  REJEITADA
}

enum InvoiceDirection {
  /// O cliente é o adquirente (uma despesa dele).
  COMPRA
  /// O cliente é o emitente (uma venda dele).
  VENDA
  DESCONHECIDA
}

/**
 * Um documento fiscal anexado a um email de um cliente, com os campos que o agente extraiu.
 */
model Invoice {
  id               String           @id @default(uuid()) @db.Uuid
  clientId         String           @map("client_id") @db.Uuid
  emailId          String           @map("email_id") @db.Uuid
  /// A parte do email onde vem o anexo: com a conta e o id do email, é como se descarrega do Gmail.
  attachmentPartId String           @map("attachment_part_id")
  fileName         String           @map("file_name")
  mimeType         String           @map("mime_type")
  docType          InvoiceDocType   @default(OUTRO) @map("doc_type")
  direction        InvoiceDirection @default(DESCONHECIDA)
  number           String?
  atcud            String?
  issueDate        DateTime?        @map("issue_date") @db.Date
  issuerName       String?          @map("issuer_name")
  issuerNif        String?          @map("issuer_nif")
  buyerName        String?          @map("buyer_name")
  buyerNif         String?          @map("buyer_nif")
  netTotal         Decimal?         @map("net_total") @db.Decimal(14, 2)
  vatTotal         Decimal?         @map("vat_total") @db.Decimal(14, 2)
  total            Decimal?         @db.Decimal(14, 2)
  currency         String           @default("EUR")
  /// O IVA por taxa: [{ rate, base, vat }].
  vatBreakdown     Json?            @map("vat_breakdown")
  confidence       Float
  status           InvoiceStatus    @default(A_REVER)
  /// Porque ficou a rever (em palavras).
  reviewReasons    String[]         @map("review_reasons")
  raw              Json
  reviewedById     String?          @map("reviewed_by_id") @db.Uuid
  reviewedAt       DateTime?        @map("reviewed_at")
  createdAt        DateTime         @default(now()) @map("created_at")
  updatedAt        DateTime         @updatedAt @map("updated_at")
  client           Client           @relation(fields: [clientId], references: [id], onDelete: Cascade)
  email            ClientEmail      @relation(fields: [emailId], references: [id], onDelete: Cascade)

  @@unique([emailId, attachmentPartId])
  @@index([clientId, issueDate])
  @@index([status])
  @@map("invoices")
}

/**
 * Até onde o agente de faturas já leu cada caixa.
 */
model MailSyncState {
  googleAccountId String        @id @map("google_account_id") @db.Uuid
  /// Os emails até aqui já foram todos vistos.
  syncedUntil     DateTime?     @map("synced_until")
  lastRunAt       DateTime?     @map("last_run_at")
  lastError       String?       @map("last_error")
  googleAccount   GoogleAccount @relation(fields: [googleAccountId], references: [id], onDelete: Cascade)

  @@map("mail_sync_states")
}

/**
 * Os emails de cada caixa já tratados (guardados, repetidos noutra caixa, ou sem nada): não se voltam a ler.
 */
model MailSeenMessage {
  googleAccountId String        @map("google_account_id") @db.Uuid
  gmailMessageId  String        @map("gmail_message_id")
  seenAt          DateTime      @default(now()) @map("seen_at")
  googleAccount   GoogleAccount @relation(fields: [googleAccountId], references: [id], onDelete: Cascade)

  @@id([googleAccountId, gmailMessageId])
  @@map("mail_seen_messages")
}

/**
 * Um trinco para uma tarefa não correr duas vezes ao mesmo tempo (o agendamento e o botão).
 */
model JobLock {
  name        String   @id
  lockedUntil DateTime @map("locked_until")

  @@map("job_locks")
}
