# Banco de dados (docker compose up -d db)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/elevateone?schema=public"

# Segredo para assinar a sessão (mín. 32 caracteres). Gere com: openssl rand -base64 48
SESSION_SECRET="troque-este-segredo-por-um-valor-aleatorio-e-longo"

# Usuário padrão criado pelo seed (npm run db:seed). TROQUE em produção.
DEFAULT_ADMIN_NAME="Administrador"
DEFAULT_ADMIN_EMAIL="admin@elevateone.local"
DEFAULT_ADMIN_PASSWORD="Admin@123"

# Agentes (Claude). A chave cria-se em https://platform.claude.com
ANTHROPIC_API_KEY=""
# Opcionais: o modelo e o esforço de raciocínio (low | medium | high | xhigh | max)
ANTHROPIC_MODEL="claude-opus-5-5"
ANTHROPIC_EFFORT="medium"

# Base de conhecimento (embeddings) e, mais tarde, a transcrição de áudio
OPENAI_API_KEY=""

# Google (Agenda, Gmail, Contactos, Drive). Credenciais OAuth de «Aplicação Web» no Google Cloud,
# com o URI de redirecionamento <APP_URL>/api/google/callback
APP_URL="http://localhost:3000"
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
# Cifra os acessos guardados no banco. Gere com: openssl rand -hex 32
ENCRYPTION_KEY=""

# WhatsApp (Evolution API). O webhook da instância aponta para <APP_URL>/api/webhooks/whatsapp,
# com o evento MESSAGES_UPSERT e o cabeçalho x-webhook-secret igual a WHATSAPP_WEBHOOK_SECRET.
EVOLUTION_API_URL="http://localhost:8080"
EVOLUTION_API_KEY=""
EVOLUTION_INSTANCE="escritorio"
# Gere com: openssl rand -hex 32
WHATSAPP_WEBHOOK_SECRET=""
