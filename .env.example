# Banco de dados (docker compose up -d db)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/elevateone?schema=public"

# Segredo para assinar a sessão (mín. 32 caracteres). Gere com: openssl rand -base64 48
SESSION_SECRET="troque-este-segredo-por-um-valor-aleatorio-e-longo"

# Usuário padrão criado pelo seed (npm run db:seed). TROQUE em produção.
DEFAULT_ADMIN_NAME="Administrador"
DEFAULT_ADMIN_EMAIL="admin@elevateone.local"
DEFAULT_ADMIN_PASSWORD="Admin@123"
